uses System;

procedure fib(i, n: integer);
begin
    { ДЕКОМПОЗИЦИЯ: вывод текущего числа Фибоначчи (суммы двух предыдущих) }
  Print(i + n);
  Print(' ');
  
    { БАЗИС: условие продолжения рекурсии - пока не достигнуто ограничение }
  if n < 55 then
        { РЕКУРСИВНЫЙ ВЫЗОВ: переход к следующему числу со сдвигом параметров }
    fib(n, i + n);
end;

begin
  Println('Первые 10 чисел Фибоначчи:');
  fib(0, 1);
  Println();
end.