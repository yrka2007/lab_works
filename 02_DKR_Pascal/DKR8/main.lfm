object fMain: TfMain
  Left = 0
  Height = 250
  Top = 0
  Width = 400
  BorderStyle = bsDialog
  Caption = 'Таймер'
  ClientHeight = 250
  ClientWidth = 400
  Position = poDesktopCenter
  OnCreate = FormCreate
  object lblHours: TLabel
    Left = 30
    Height = 15
    Top = 30
    Width = 35
    Caption = 'Часы:'
  end
  object lblMinutes: TLabel
    Left = 150
    Height = 15
    Top = 30
    Width = 42
    Caption = 'Минуты:'
  end
  object lblSeconds: TLabel
    Left = 270
    Height = 15
    Top = 30
    Width = 44
    Caption = 'Секунды:'
  end
  object edtHours: TEdit
    Left = 30
    Height = 23
    Top = 50
    Width = 50
    Text = '0'
  end
  object lblColon1: TLabel
    Left = 90
    Height = 15
    Top = 54
    Width = 7
    Caption = ':'
  end
  object edtMinutes: TEdit
    Left = 105
    Height = 23
    Top = 50
    Width = 50
    Text = '0'
  end
  object lblColon2: TLabel
    Left = 165
    Height = 15
    Top = 54
    Width = 7
    Caption = ':'
  end
  object edtSeconds: TEdit
    Left = 180
    Height = 23
    Top = 50
    Width = 50
    Text = '5'
  end
  object btnStart: TButton
    Left = 30
    Height = 25
    Top = 100
    Width = 100
    Caption = 'Старт'
    OnClick = btnStartClick
  end
  object btnStop: TButton
    Left = 150
    Height = 25
    Top = 100
    Width = 100
    Caption = 'Стоп'
    Enabled = False
    OnClick = btnStopClick
  end
  object lblStatus: TLabel
    Left = 30
    Height = 15
    Top = 150
    Width = 250
    Caption = 'Введите время и нажмите "Старт"'
  end
  object lblRemaining: TLabel
    Left = 30
    Height = 15
    Top = 180
    Width = 250
    Caption = 'Осталось: 0 ч 0 мин 0 с'
  end
  object Timer1: TTimer
    Enabled = False
    Interval = 1000
    OnTimer = Timer1Timer
  end
end
