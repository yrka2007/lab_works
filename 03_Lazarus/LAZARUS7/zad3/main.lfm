object Form1: TForm1
  Left = 0
  Height = 200
  Top = 0
  Width = 450
  BorderStyle = bsDialog
  Caption = 'Копирование файла'
  ClientHeight = 200
  ClientWidth = 450
  Position = poDesktopCenter
  OnCreate = FormCreate
  object Label1: TLabel
    Left = 16
    Height = 15
    Top = 16
    Width = 200
    Caption = 'Выберите файл, который нужно копировать:'
  end
  object FNE: TFileNameEdit
    Left = 16
    Height = 23
    Top = 36
    Width = 400
    Filter = 'Все файлы (*.*)|*.*'
  end
  object Label2: TLabel
    Left = 16
    Height = 15
    Top = 72
    Width = 200
    Caption = 'Укажите папку, куда копировать файл:'
  end
  object DE: TDirectoryEdit
    Left = 16
    Height = 23
    Top = 92
    Width = 400
  end
  object btnCopy: TButton
    Left = 16
    Height = 25
    Top = 132
    Width = 120
    Caption = 'Выполнить копирование'
    OnClick = btnCopyClick
  end
end
